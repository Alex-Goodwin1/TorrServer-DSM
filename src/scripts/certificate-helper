#!/bin/sh
#
# Runs as root through sudo. Every path that comes from the (user-writable)
# package var directory is treated as untrusted: it is resolved with
# readlink -f and must stay inside the allowed root after resolution.

CERT_ROOT="/usr/syno/etc/certificate"
CONFIG_DIR="/var/packages/TorrServer/var"
TARGET_CERT="${CONFIG_DIR}/server.pem"
TARGET_KEY="${CONFIG_DIR}/server.key"
LOG_FILE="${CONFIG_DIR}/Helper.log"

log_message()
{
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -ge 2097152 ]; then
        mv -f "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null
    fi

    printf '%s certificate-helper: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$LOG_FILE" 2>/dev/null
}

fail()
{
    log_message "ERROR: $1"
    echo "$1" >&2
    exit 1
}

list_certificates()
{
    printf '['
    first=1

    find "$CERT_ROOT" -type f -name info 2>/dev/null | while IFS= read -r info; do
        data=$(cat "$info" 2>/dev/null) || continue

        if [ "$first" -eq 0 ]; then
            printf ','
        fi
        first=0

        printf '%s' "$data"
    done

    printf ']\n'
}

# resolve_path <path> <mode>
# Prints the resolved path when it is a regular file inside the allowed root.
resolve_path()
{
    candidate="$1"
    mode="$2"

    case "$candidate" in
        */../*|*/..|../*|..) return 1 ;;
    esac

    real="$(readlink -f -- "$candidate" 2>/dev/null)" || return 1
    [ -n "$real" ] || return 1

    case "$mode" in
        dsm)
            case "$real" in
                "${CERT_ROOT}"/*) ;;
                *) return 1 ;;
            esac
            ;;
        manual)
            case "$real" in
                /volume[0-9]*/*) ;;
                *) return 1 ;;
            esac
            ;;
        *)
            return 1
            ;;
    esac

    [ -f "$real" ] || return 1
    printf '%s\n' "$real"
}

# install_file <source> <target> <mode>
# Copies through a fresh temporary file (never follows a pre-existing one) and
# renames it over the target, so a symlink planted at the target is replaced
# instead of followed.
install_file()
{
    src="$1"
    dst="$2"
    perm="$3"
    tmp="${dst}.tmp"

    rm -f -- "$tmp"

    ( set -C; umask 077; cat -- "$src" > "$tmp" ) || return 1

    chown -h TorrServer:TorrServer "$tmp" || { rm -f -- "$tmp"; return 1; }
    chmod "$perm" "$tmp" || { rm -f -- "$tmp"; return 1; }
    mv -f -- "$tmp" "$dst" || { rm -f -- "$tmp"; return 1; }
}

sync_certificate()
{
    MODE="$(cat "${CONFIG_DIR}/torrserver.ssl.mode" 2>/dev/null)"

    case "$MODE" in
        self|"")
            exit 0
            ;;
        dsm|manual)
            ;;
        *)
            fail "Invalid certificate mode: ${MODE}"
            ;;
    esac

    CERT_RAW="$(cat "${CONFIG_DIR}/torrserver.ssl.cert" 2>/dev/null)"
    KEY_RAW="$(cat "${CONFIG_DIR}/torrserver.ssl.key" 2>/dev/null)"

    if [ -z "$CERT_RAW" ] || [ -z "$KEY_RAW" ]; then
        fail "Certificate or key path is empty"
    fi

    CERT="$(resolve_path "$CERT_RAW" "$MODE")" || fail "Invalid or missing certificate file"
    KEY="$(resolve_path "$KEY_RAW" "$MODE")" || fail "Invalid or missing key file"

    NEED_CERT=1
    NEED_KEY=1

    if [ -f "$TARGET_CERT" ] && [ ! -L "$TARGET_CERT" ] && cmp -s "$CERT" "$TARGET_CERT"; then
        NEED_CERT=0
    fi

    if [ -f "$TARGET_KEY" ] && [ ! -L "$TARGET_KEY" ] && cmp -s "$KEY" "$TARGET_KEY"; then
        NEED_KEY=0
    fi

    if [ "$NEED_CERT" -eq 0 ] && [ "$NEED_KEY" -eq 0 ]; then
        exit 0
    fi

    # Stage both files first and only then rename them, so TorrServer never
    # sees a certificate that does not belong to the key.
    STAGE_CERT="${TARGET_CERT}.stage"
    STAGE_KEY="${TARGET_KEY}.stage"
    rm -f -- "$STAGE_CERT" "$STAGE_KEY"

    install_file "$CERT" "$STAGE_CERT" 0644 || { rm -f -- "$STAGE_CERT" "$STAGE_KEY"; fail "Failed to copy certificate"; }
    install_file "$KEY" "$STAGE_KEY" 0600 || { rm -f -- "$STAGE_CERT" "$STAGE_KEY"; fail "Failed to copy key"; }

    mv -f -- "$STAGE_CERT" "$TARGET_CERT" || fail "Failed to install certificate"
    mv -f -- "$STAGE_KEY" "$TARGET_KEY" || fail "Failed to install key"

    log_message "TLS certificate synchronized successfully (mode: ${MODE})"
    exit 0
}

case "$1" in
    sync)
        sync_certificate
        ;;
    *)
        list_certificates
        ;;
esac
