#!/bin/sh

SUDOERS_DIR="/etc/sudoers.d"
SUDOERS_FILE="${SUDOERS_DIR}/TorrServer"
TMP_FILE="${SUDOERS_FILE}.tmp"
RESTART_SCRIPT="/var/packages/TorrServer/scripts/restart-package"
CERTIFICATE_HELPER="/var/packages/TorrServer/scripts/certificate-helper"
PREPARE_DIRECTORY="/var/packages/TorrServer/scripts/prepare-directory"

if [ "$(id -u)" -ne 0 ]; then
    echo "This script must be run as root."
    exit 1
fi

if [ ! -x "${RESTART_SCRIPT}" ] || [ ! -x "${CERTIFICATE_HELPER}" ] || [ ! -x "${PREPARE_DIRECTORY}" ]; then
    echo "TorrServer package scripts are not available."
    exit 1
fi

/bin/mkdir -p "${SUDOERS_DIR}" || exit 1

/bin/rm -f "${TMP_FILE}"

printf '%s\n' "TorrServer ALL=(root) NOPASSWD: ${RESTART_SCRIPT}, ${CERTIFICATE_HELPER}, ${PREPARE_DIRECTORY}" > "${TMP_FILE}" || exit 1

/bin/chmod 0440 "${TMP_FILE}" || exit 1
/bin/chown root:root "${TMP_FILE}" || exit 1

# A syntax error in /etc/sudoers.d breaks sudo for the whole system.
if command -v visudo >/dev/null 2>&1; then
    if ! visudo -cf "${TMP_FILE}" >/dev/null 2>&1; then
        /bin/rm -f "${TMP_FILE}"
        echo "Generated sudoers file failed validation."
        exit 1
    fi
fi

/bin/mv -f "${TMP_FILE}" "${SUDOERS_FILE}" || exit 1

if [ ! -r "${SUDOERS_FILE}" ]; then
    echo "Failed to create ${SUDOERS_FILE}."
    exit 1
fi

echo "TorrServer DSM permissions configured successfully."
exit 0
