#!/bin/sh

if [ -z "${SYNOPKG_PKGNAME}" ] || [ -z "${SYNOPKG_DSM_VERSION_MAJOR}" ]; then
    echo "Error: Environment variables are not set." 1>&2
    echo "Please run this script through synopkg." 1>&2
    exit 1
fi

USER="TorrServer"
EFF_USER="TorrServer"

LOG_FILE="/var/packages/${SYNOPKG_PKGNAME}/var/${SYNOPKG_PKGNAME}.log"
PID_FILE="/var/packages/${SYNOPKG_PKGNAME}/var/${SYNOPKG_PKGNAME}.pid"
CONFIG_DIR="/var/packages/${SYNOPKG_PKGNAME}/var"
TORRSERVER_LOG="${CONFIG_DIR}/TorrServer.log"
CERTIFICATE_HELPER="/var/packages/${SYNOPKG_PKGNAME}/scripts/certificate-helper"

TORRSERVER_PORT="8090"
if [ -r "${CONFIG_DIR}/torrserver.port" ]; then
    SAVED_PORT="$(cat "${CONFIG_DIR}/torrserver.port" 2>/dev/null)"
    case "${SAVED_PORT}" in
        ''|*[!0-9]*) ;;
        *)
            if [ "${SAVED_PORT}" -ge 1 ] 2>/dev/null &&
               [ "${SAVED_PORT}" -le 65535 ] 2>/dev/null; then
                TORRSERVER_PORT="${SAVED_PORT}"
            fi
            ;;
    esac
fi

AUTH_ENABLED="0"
if [ "$(cat "${CONFIG_DIR}/torrserver.auth" 2>/dev/null)" = "1" ] &&
   [ -r "${CONFIG_DIR}/accs.db" ]; then
    AUTH_ENABLED="1"
fi

HTTPS_ENABLED="0"
if [ "$(cat "${CONFIG_DIR}/torrserver.https" 2>/dev/null)" = "1" ]; then
    HTTPS_ENABLED="1"
fi

HTTPS_PORT="8091"
if [ -r "${CONFIG_DIR}/torrserver.https.port" ]; then
    SAVED_HTTPS_PORT="$(cat "${CONFIG_DIR}/torrserver.https.port" 2>/dev/null)"
    case "${SAVED_HTTPS_PORT}" in
        ''|*[!0-9]*) ;;
        *)
            if [ "${SAVED_HTTPS_PORT}" -ge 1 ] 2>/dev/null &&
               [ "${SAVED_HTTPS_PORT}" -le 65535 ] 2>/dev/null; then
                HTTPS_PORT="${SAVED_HTTPS_PORT}"
            fi
            ;;
    esac
fi

TORRSERVER_SSL_ARGS=""
if [ "${HTTPS_ENABLED}" = "1" ]; then
    TORRSERVER_SSL_ARGS="--ssl --sslport ${HTTPS_PORT}"

    if [ "$(cat "${CONFIG_DIR}/torrserver.force.https" 2>/dev/null)" = "1" ]; then
        TORRSERVER_SSL_ARGS="${TORRSERVER_SSL_ARGS} --force-https"
    fi
fi

update_firewall_port()
{
    local sc_file="${SYNOPKG_PKGDEST}/ui/TorrServer.sc"
    local firewall_ports="${TORRSERVER_PORT},8095"

    if [ "${HTTPS_ENABLED}" = "1" ]; then
        firewall_ports="${firewall_ports},${HTTPS_PORT}"
    fi

    cat > "${sc_file}" <<EOF2
[torrserver]
title="TorrServer DSM"
desc="TorrServer DSM"
port_forward="yes"
dst.ports="${firewall_ports}/tcp"
EOF2

    /usr/syno/sbin/synopkghelper update "${SYNOPKG_PKGNAME}" port-config >/dev/null 2>&1
}

if [ -d "${SYNOPKG_PKGDEST}/ui" ]; then
    update_firewall_port
fi

if [ -x "${CERTIFICATE_HELPER}" ]; then
    /bin/sudo -n "${CERTIFICATE_HELPER}" sync
    if [ "$?" -ne 0 ]; then
        echo "Warning: TLS certificate synchronization is unavailable. Configure DSM permissions if required." 1>&2
    fi
fi

if [ "${AUTH_ENABLED}" = "1" ]; then
    SERVICE_COMMAND="/bin/python3 ${SYNOPKG_PKGDEST}/helper/helper.py
${SYNOPKG_PKGDEST}/bin/TorrServer -d ${SYNOPKG_PKGVAR} -p ${TORRSERVER_PORT} -a ${TORRSERVER_SSL_ARGS} -l ${TORRSERVER_LOG}"
else
    SERVICE_COMMAND="/bin/python3 ${SYNOPKG_PKGDEST}/helper/helper.py
${SYNOPKG_PKGDEST}/bin/TorrServer -d ${SYNOPKG_PKGVAR} -p ${TORRSERVER_PORT} ${TORRSERVER_SSL_ARGS} -l ${TORRSERVER_LOG}"
fi

SVC_BACKGROUND=y
SVC_WRITE_PID=y

service_preupgrade()
{
    if [ -d "${SYNOPKG_PKGDEST}/config/" ] &&
       [ "$(ls -A "${SYNOPKG_PKGDEST}/config/" 2>/dev/null)" ]; then
        if [ -r "${SYNOPKG_PKGDEST}/config/${SYNOPKG_PKGNAME}.sc" ]; then
            $RM "${SYNOPKG_PKGDEST}/config/${SYNOPKG_PKGNAME}.sc" | install_log
        fi
        echo "Backup target/config folder" | install_log
        echo "$RSYNC ${SYNOPKG_PKGDEST}/config/ ${TMP_DIR}" | install_log
        $RSYNC "${SYNOPKG_PKGDEST}/config/" "${TMP_DIR}" 2>&1 | install_log
    fi
}


service_postupgrade()
{
    /usr/syno/bin/synosystemctl reload nginx.service
}

