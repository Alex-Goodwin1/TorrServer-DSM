#!/bin/sh

if [ -z "${SYNOPKG_PKGNAME}" ] || [ -z "${SYNOPKG_DSM_VERSION_MAJOR}" ]; then
    echo "Error: Environment variables are not set." 1>&2
    echo "Please run this script through synopkg." 1>&2
    exit 1
fi

USER="TorrServer"
EFF_USER="TorrServer"

LOG_FILE="/var/packages/${SYNOPKG_PKGNAME}/var/${SYNOPKG_PKGNAME}.log"
PID_FILE="/var/packages/${SYNOPKG_PKGNAME}/var/${SYNOPKG_PKGNAME}.pid"
CONFIG_DIR="/var/packages/${SYNOPKG_PKGNAME}/var"
TORRSERVER_LOG="${CONFIG_DIR}/TorrServer.log"
CERTIFICATE_HELPER="/var/packages/${SYNOPKG_PKGNAME}/scripts/certificate-helper"

find_binary()
{
    for _candidate in "$@"; do
        if [ -x "${_candidate}" ]; then
            printf '%s\n' "${_candidate}"
            return 0
        fi
    done
    return 1
}

find_python()
{
    for _candidate in /bin/python3 /usr/bin/python3 /usr/local/bin/python3 \
                      /bin/python3.* /usr/bin/python3.* /usr/local/bin/python3.* \
                      /var/packages/Python*/target/bin/python3* \
                      /var/packages/python3*/target/bin/python3* \
                      /opt/bin/python3 /opt/bin/python3.* \
                      /usr/local/bin/python /opt/bin/python; do
        [ -x "${_candidate}" ] || continue
        if "${_candidate}" -c 'import http.server, ssl, sys; raise SystemExit(0 if sys.version_info >= (3, 7) else 1)' >/dev/null 2>&1; then
            printf '%s\n' "${_candidate}"
            return 0
        fi
    done
    return 1
}

PYTHON_BIN="$(find_python || true)"
SYNOPKGHELPER_BIN="$(find_binary /usr/syno/sbin/synopkghelper /usr/syno/bin/synopkghelper || true)"
SYNOPKGCTL_BIN="$(find_binary /usr/syno/bin/synosystemctl /usr/bin/systemctl /bin/systemctl || true)"
SUDO_BIN="$(find_binary /bin/sudo /usr/bin/sudo /usr/local/bin/sudo || true)"

TORRSERVER_PORT="8090"
if [ -r "${CONFIG_DIR}/torrserver.port" ]; then
    SAVED_PORT="$(cat "${CONFIG_DIR}/torrserver.port" 2>/dev/null)"
    case "${SAVED_PORT}" in
        ''|*[!0-9]*) ;;
        *)
            if [ "${SAVED_PORT}" -ge 1 ] 2>/dev/null &&
               [ "${SAVED_PORT}" -le 65535 ] 2>/dev/null; then
                TORRSERVER_PORT="${SAVED_PORT}"
            fi
            ;;
    esac
fi

AUTH_ENABLED="0"
if [ "$(cat "${CONFIG_DIR}/torrserver.auth" 2>/dev/null)" = "1" ] &&
   [ -r "${CONFIG_DIR}/accs.db" ]; then
    AUTH_ENABLED="1"
fi

HTTPS_ENABLED="0"
if [ "$(cat "${CONFIG_DIR}/torrserver.https" 2>/dev/null)" = "1" ]; then
    HTTPS_ENABLED="1"
fi

HTTPS_PORT="8091"
if [ -r "${CONFIG_DIR}/torrserver.https.port" ]; then
    SAVED_HTTPS_PORT="$(cat "${CONFIG_DIR}/torrserver.https.port" 2>/dev/null)"
    case "${SAVED_HTTPS_PORT}" in
        ''|*[!0-9]*) ;;
        *)
            if [ "${SAVED_HTTPS_PORT}" -ge 1 ] 2>/dev/null &&
               [ "${SAVED_HTTPS_PORT}" -le 65535 ] 2>/dev/null; then
                HTTPS_PORT="${SAVED_HTTPS_PORT}"
            fi
            ;;
    esac
fi

TORRSERVER_SSL_ARGS=""
if [ "${HTTPS_ENABLED}" = "1" ]; then
    TORRSERVER_SSL_ARGS="--ssl --sslport ${HTTPS_PORT}"

    if [ "$(cat "${CONFIG_DIR}/torrserver.force.https" 2>/dev/null)" = "1" ]; then
        TORRSERVER_SSL_ARGS="${TORRSERVER_SSL_ARGS} --force-https"
    fi
fi

update_firewall_port()
{
    local sc_file="${SYNOPKG_PKGDEST}/ui/TorrServer.sc"
    local firewall_ports="${TORRSERVER_PORT},8095"

    if [ "${HTTPS_ENABLED}" = "1" ]; then
        firewall_ports="${firewall_ports},${HTTPS_PORT}"
    fi

    cat > "${sc_file}" <<EOF2
[torrserver]
title="TorrServer DSM"
desc="TorrServer DSM"
port_forward="yes"
dst.ports="${firewall_ports}/tcp"
EOF2

    if [ -n "${SYNOPKGHELPER_BIN}" ]; then
        "${SYNOPKGHELPER_BIN}" update "${SYNOPKG_PKGNAME}" port-config >/dev/null 2>&1 || true
    fi
}

if [ -d "${SYNOPKG_PKGDEST}/ui" ]; then
    update_firewall_port
fi

if [ -n "${SUDO_BIN}" ] && [ -x "${CERTIFICATE_HELPER}" ]; then
    if ! "${SUDO_BIN}" -n "${CERTIFICATE_HELPER}" sync >/dev/null 2>&1; then
        echo "Warning: TLS certificate synchronization is unavailable. Configure DSM permissions if required." 1>&2
    fi
fi

TORRSERVER_ARGS="-d ${SYNOPKG_PKGVAR} -p ${TORRSERVER_PORT} ${TORRSERVER_SSL_ARGS} -l ${TORRSERVER_LOG}"
if [ "${AUTH_ENABLED}" = "1" ]; then
    TORRSERVER_ARGS="-a ${TORRSERVER_ARGS}"
fi

if [ -n "${PYTHON_BIN}" ]; then
    SERVICE_COMMAND="${PYTHON_BIN} ${SYNOPKG_PKGDEST}/helper/helper.py
${SYNOPKG_PKGDEST}/bin/TorrServer ${TORRSERVER_ARGS}"
else
    echo "Warning: no usable Python 3 (>= 3.7 with ssl) found; the TorrServer DSM UI (helper) will be unavailable." 1>&2
    echo "Warning: install the SynoCommunity python311/python312/python313 package (or Entware python3), or link an interpreter to /usr/local/bin/python3." 1>&2
    SERVICE_COMMAND="${SYNOPKG_PKGDEST}/bin/TorrServer ${TORRSERVER_ARGS}"
fi

SVC_BACKGROUND=y
SVC_WRITE_PID=y

service_preupgrade()
{
    if [ -d "${SYNOPKG_PKGDEST}/config/" ] &&
       [ "$(ls -A "${SYNOPKG_PKGDEST}/config/" 2>/dev/null)" ]; then
        if [ -r "${SYNOPKG_PKGDEST}/config/${SYNOPKG_PKGNAME}.sc" ]; then
            $RM "${SYNOPKG_PKGDEST}/config/${SYNOPKG_PKGNAME}.sc" | install_log
        fi
        echo "Backup target/config folder" | install_log
        echo "$RSYNC ${SYNOPKG_PKGDEST}/config/ ${TMP_DIR}" | install_log
        $RSYNC "${SYNOPKG_PKGDEST}/config/" "${TMP_DIR}" 2>&1 | install_log
    fi
}


service_postupgrade()
{
    if [ -n "${SYNOPKGCTL_BIN}" ]; then
        "${SYNOPKGCTL_BIN}" reload nginx.service >/dev/null 2>&1 ||
            "${SYNOPKGCTL_BIN}" reload nginx >/dev/null 2>&1 || true
    fi

    return 0
}

