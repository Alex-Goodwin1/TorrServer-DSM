#!/bin/sh
#
# Runs as root through sudo. The argument is untrusted: it is resolved and
# must stay inside a /volumeN/ share, and symlinks are never followed.

if [ "$(id -u)" -ne 0 ]; then
    echo "This script must be run as root."
    exit 1
fi

# Exit code 64 (EX_USAGE) is distinct from sudo's own refusal (1), so the
# Helper can probe "is this script allowed through sudo?" without a directory
# and without depending on sudo's (localized) messages.
if [ "$#" -ne 1 ]; then
    echo "Usage: prepare-directory <TorrServer directory>"
    exit 64
fi

INPUT="$1"

case "${INPUT}" in
    */../*|*/..|../*|..)
        echo "Invalid TorrServer directory."
        exit 1
        ;;
    *[[:space:]]*)
        echo "TorrServer directory must not contain spaces."
        exit 1
        ;;
esac

# Strip trailing slashes.
while [ "${INPUT}" != "/" ] && [ "${INPUT%/}" != "${INPUT}" ]; do
    INPUT="${INPUT%/}"
done

case "${INPUT}" in
    /volume[0-9]/?*|/volume[0-9][0-9]/?*)
        ;;
    *)
        echo "Invalid TorrServer directory."
        exit 1
        ;;
esac

if [ -L "${INPUT}" ]; then
    echo "TorrServer directory must not be a symbolic link."
    exit 1
fi

if [ ! -e "${INPUT}" ]; then
    if ! /bin/mkdir -p "${INPUT}"; then
        echo "Failed to create TorrServer directory."
        exit 1
    fi
fi

if [ ! -d "${INPUT}" ]; then
    echo "TorrServer directory is not a directory."
    exit 1
fi

# Resolve again after creation: no component may point outside /volumeN/.
TORRSERVER_DIR="$(readlink -f -- "${INPUT}" 2>/dev/null)"

case "${TORRSERVER_DIR}" in
    /volume[0-9]/?*|/volume[0-9][0-9]/?*)
        ;;
    *)
        echo "Invalid TorrServer directory."
        exit 1
        ;;
esac

CACHE_DIR="${TORRSERVER_DIR}/Cache"
FUSE_DIR="${TORRSERVER_DIR}/FUSE"

prepare_subdir()
{
    SUBDIR="$1"

    if [ -L "${SUBDIR}" ]; then
        echo "TorrServer subdirectory must not be a symbolic link: ${SUBDIR}"
        return 1
    fi

    if [ -e "${SUBDIR}" ]; then
        if [ ! -d "${SUBDIR}" ]; then
            echo "TorrServer subdirectory is not a directory: ${SUBDIR}"
            return 1
        fi

        OWNER="$(/bin/stat -c '%U:%G' "${SUBDIR}" 2>/dev/null)"

        if [ "${OWNER}" != "TorrServer:TorrServer" ]; then
            echo "TorrServer subdirectory has unexpected ownership: ${SUBDIR}"
            return 1
        fi

        return 0
    fi

    if ! /bin/mkdir "${SUBDIR}"; then
        echo "Failed to create TorrServer subdirectory: ${SUBDIR}"
        return 1
    fi

    if ! /bin/chown -h TorrServer:TorrServer "${SUBDIR}"; then
        echo "Failed to set directory ownership: ${SUBDIR}"
        return 1
    fi

    if ! /bin/chmod 0755 "${SUBDIR}"; then
        echo "Failed to set directory permissions: ${SUBDIR}"
        return 1
    fi

    return 0
}

prepare_subdir "${CACHE_DIR}" || exit 1
prepare_subdir "${FUSE_DIR}" || exit 1

exit 0
