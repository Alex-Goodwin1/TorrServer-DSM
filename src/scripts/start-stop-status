#!/bin/sh

# Start / stop / status for DSM 7 (DSM runs this with bash as /bin/sh).
# service-setup provides SERVICE_COMMAND (one command per line), LOG_FILE,
# PID_FILE and service_prestart.

DNAME="${SYNOPKG_PKGNAME}"

# Source package specific variable and functions
SVC_SETUP=$(dirname "$0")"/service-setup"
if [ -r "${SVC_SETUP}" ]; then
    . "${SVC_SETUP}"
fi


# Every line of SERVICE_COMMAND is started in the background as the package
# user (DSM sets the user through conf/privilege); their pids are written to
# PID_FILE, separated by spaces.
start_daemon ()
{
    i=0
    date > "${LOG_FILE}"
    service_prestart >> "${LOG_FILE}" 2>&1
    printf "%s" "$SERVICE_COMMAND" | while read -r service || [ -n "$service" ]
    do
        i=$((i + 1))
        echo "Starting ${DNAME} command ${service}" >> "${LOG_FILE}"
        if [ -n "${service}" ]; then
            # The command line is split into words on purpose.
            # shellcheck disable=SC2086
            ${service} >> "${LOG_FILE}" 2>&1 &
            if [ "$i" -eq 1 ]; then
                printf '%s' "$!" > "${PID_FILE}"
            else
                printf ' %s' "$!" >> "${PID_FILE}"
            fi
        fi
    done
}

stop_daemon ()
{
    if [ -r "${PID_FILE}" ]; then
        # The pid file holds several pids separated by spaces.
        # shellcheck disable=SC2013
        for pid in $(cat "${PID_FILE}")
        do
            date >> "${LOG_FILE}"
            echo "Stopping ${DNAME} service : $(ps -p"${pid}" -o comm=) (${pid})" >> "${LOG_FILE}"
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
            wait_for_status 1 "${SVC_WAIT_TIMEOUT:-20}" "${pid}" || kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
        done
        rm -f "${PID_FILE}"
    fi
}

#------------------------------------------------------
# daemon_status()
#     $1: PID to check, if empty use ${PID_FILE}
#
# Return 0 when all pids are alive, else 1 (a stale pid
# file is removed).
#------------------------------------------------------
daemon_status ()
{
    failed=0
    if [ -z "${1}" ]; then
        pid_list=$(cat "${PID_FILE}" 2>/dev/null)
    else
        pid_list=${1}
    fi

    [ -n "${pid_list}" ] || return 1

    for pid in ${pid_list}
    do
        kill -0 "${pid}" > /dev/null 2>&1 || failed=$((failed + 1))
    done

    if [ "${failed}" -ne 0 ]; then
        rm -f "${PID_FILE}"
        return 1
    fi

    return 0
}

#------------------------------------------------------
# wait_for_status()
#      $1: expected return from daemon_status()
#      $2: timeout in seconds
#      $3: PID to check, passed to daemon_status()
#
# Return 0 as soon as daemon_status() returns the
# expected value, 1 when the timeout is over.
#------------------------------------------------------
wait_for_status ()
{
    counter=${2}
    while [ "${counter}" -gt 0 ]; do
        daemon_status "${3}"
        [ $? -eq "$1" ] && return 0
        counter=$((counter - 1))
        sleep 1
    done
    return 1
}

case $1 in
    start)
        if daemon_status; then
            echo "${DNAME} is already running" >> "${LOG_FILE}"
            exit 0
        else
            echo "Starting ${DNAME} ..." >> "${LOG_FILE}"
            start_daemon
            exit $?
        fi
        ;;
    stop)
        if daemon_status; then
            echo "Stopping ${DNAME} ..." >> "${LOG_FILE}"
            stop_daemon
            exit $?
        else
            echo "${DNAME} is not running" >> "${LOG_FILE}"
            exit 0
        fi
        ;;
    status)
        if daemon_status; then
            echo "${DNAME} is running"
            exit 0
        else
            echo "${DNAME} is not running"
            exit 3
        fi
        ;;
    *)
        exit 1
        ;;
esac
